{
  "name": "quad-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Backend for Quad — a single-campus student marketplace",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "seed:categories": "node seed/seedCategories.js",
    "test": "node --experimental-vm-modules node_modules/.bin/vitest run",
    "boot-check": "node boot-check.mjs",
    "models:compile": "node --input-type=module -e \"import('./models/User.js').then(()=>console.log('All models compile OK')).catch(e=>{console.error('MODEL COMPILE FAIL:',e.message);process.exit(1)})\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.1",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "8.24.3",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^9.0.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.3.1",
    "socket.io": "^4.8.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "mongodb-memory-server@11.2.0": true,
    "msgpackr-extract@3.0.4": true,
    "esbuild@0.21.5": true,
    "core-js@3.50.0": true
  }
}
