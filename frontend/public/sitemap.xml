<?xml version="1.0" encoding="UTF-8"?>
<!-- QD-022 — sitemap.xml. Update the domain + lastmod before deploying. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://your-domain/</loc>
    <lastmod>2026-08-27</lastmod>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://your-domain/signin</loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
  <url>
    <loc>https://your-domain/signup</loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
  <url>
    <loc>https://your-domain/privacy</loc>
    <changefreq>monthly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>https://your-domain/terms</loc>
    <changefreq>monthly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>https://your-domain/takedown</loc>
    <changefreq>monthly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>https://your-domain/accessibility</loc>
    <changefreq>monthly</changefreq>
    <priority>0.3</priority>
  </url>
  <!-- Per-listing URLs are generated dynamically by the backend (GET /api/listings
       returns titles + IDs that the frontend uses to construct /listings/:id URLs).
       For a large marketplace, generate this sitemap dynamically via a
       /api/sitemap.xml endpoint that queries active listings. -->
</urlset>
